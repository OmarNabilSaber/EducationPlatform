@{
    ViewData["Title"] = "Admin Dashboard";
}

@section Styles {
    <link href="~/css/admin-dashboard.css" rel="stylesheet" />
}

<div class="admin-dashboard">
    <div class="container">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Admin Dashboard</h1>
            <p class="dashboard-subtitle">Manage your education platform with ease</p>
        </div>
        
        <div class="dashboard-grid">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="dashboard-card card-assignments">
                        <div class="card-icon">
                            <i class="bi bi-journal-check"></i>
                        </div>
                        <h5 class="card-title">Assignments</h5>
                        <p class="card-description">Create, manage, and grade student assignments across all classes and subjects.</p>
                        <a asp-controller="Assignment" asp-action="Index" class="card-button">
                            <i class="bi bi-arrow-right"></i> Manage Assignments
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="dashboard-card card-exams">
                        <div class="card-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h5 class="card-title">Exams</h5>
                        <p class="card-description">Create comprehensive exams, set time limits, and review student submissions with detailed analytics.</p>
                        <a asp-controller="Exam" asp-action="Index" class="card-button">
                            <i class="bi bi-arrow-right"></i> Manage Exams
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="dashboard-card card-classes">
                        <div class="card-icon">
                            <i class="bi bi-people"></i>
                        </div>
                        <h5 class="card-title">Classes</h5>
                        <p class="card-description">Organize students into classes, manage enrollments, and track academic progress.</p>
                        <a asp-controller="Class" asp-action="Index" class="card-button">
                            <i class="bi bi-arrow-right"></i> Manage Classes
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="dashboard-card card-subjects">
                        <div class="card-icon">
                            <i class="bi bi-book"></i>
                        </div>
                        <h5 class="card-title">Subjects</h5>
                        <p class="card-description">Define and organize subjects, link them to classes, and manage curriculum content.</p>
                        <a asp-controller="Subject" asp-action="Index" class="card-button">
                            <i class="bi bi-arrow-right"></i> Manage Subjects
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="dashboard-card card-users">
                        <div class="card-icon">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <h5 class="card-title">User Management</h5>
                        <p class="card-description">Add, edit, and manage user accounts for students, teachers, and administrators.</p>
                        <a asp-controller="UserManagement" asp-action="Index" class="card-button">
                            <i class="bi bi-arrow-right"></i> Manage Users
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="dashboard-card card-books">
                        <div class="card-icon">
                            <i class="bi bi-collection"></i>
                        </div>
                        <h5 class="card-title">Books & Resources</h5>
                        <p class="card-description">Upload and organize educational materials, textbooks, and digital resources for students.</p>
                        <a asp-controller="Book" asp-action="Index" class="card-button">
                            <i class="bi bi-arrow-right"></i> Manage Books
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-dashboard.js"></script>
}
