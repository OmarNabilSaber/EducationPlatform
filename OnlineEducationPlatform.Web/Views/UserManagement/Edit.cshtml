    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Edit User";
}
@model EditUserViewModel

<h2 class="fw-bold text-primary mb-4">Edit User</h2>
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-soft p-4 radius-xl bg-surface">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="Student">Student</option>
                        <option value="Instructor">Instructor</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep current password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Leave blank to keep current password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            ['Password', 'ConfirmPassword'].forEach(function(id) {
                var input = document.getElementById(id);
                if (input) {
                    input.removeAttribute('data-val-required');
                }
            });
        });
    </script>
}
